{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Mappings": {
    "UserNames": {
      "Root": {
        "Name": "root"
      },
      "UserOne": {
        "Name": "UserOne"
      },
      "UserTwo": {
        "Name": "UserTwo"
      }
    }
  },
  "Resources": {
    "MyIAMPolicy": {
      "Type": "AWS::IAM::Policy",
      "Properties": {
        "PolicyName": "MySamplePolicy",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": "s3:*",
              "Resource": "*"
            }
          ]
        },
        "Users": [
          {
            "Ref": "UserOne"
          },
          {
            "Ref": "UserTwo"
          }
        ]
      }
    },
    "UserOne": {
      "Type": "AWS::IAM::User",
      "Properties": {
        "UserName": {
          "Fn::FindInMap": ["UserNames", "UserOne", "Name"]
        }
      }
    },
    "UserTwo": {
      "Type": "AWS::IAM::User",
      "Properties": {
        "UserName": {
          "Fn::FindInMap": ["UserNames", "UserTwo", "Name"]
        }
      }
    },
    "MyUserAccessKey": {
      "Type": "AWS::IAM::AccessKey",
      "Properties": {
        "UserName": {
          "Fn::FindInMap": ["UserNames", "Root", "Name"]
        }
      }
    },
    "RootUser": {
      "Type": "AWS::IAM::User",
      "Properties": {
        "UserName": {
          "Fn::FindInMap": ["UserNames", "Root", "Name"]
        }
      }
    },
    "AccessKeysRotatedConfigRule": {
      "Type": "AWS::Config::ConfigRule",
      "Properties": {
        "ConfigRuleName": "access-keys-rotated",
        "Description": "Checks whether the IAM user access keys have been rotated within the last 120 days.",
        "Scope": {
          "ComplianceResourceTypes": [
            "AWS::IAM::User"
          ]
        },
        "Source": {
          "Owner": "AWS",
          "SourceIdentifier": "ACCESS_KEYS_ROTATED"
        },
        "InputParameters": {
          "maxAccessKeyAge": "120"
        }
      }
    }
  }
}
