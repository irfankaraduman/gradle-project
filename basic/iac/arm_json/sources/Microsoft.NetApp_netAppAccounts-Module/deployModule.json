{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "myKeySourceMain": {
          "type": "string"
        }
    },
    "functions": [],
    "variables": {
        "templateLink":"http://16.40.0.248/sca/armjson/netappaccounts/deploy.json"
    },
    "resources": [
        {
        "apiVersion": "2022-09-01",
        "name": "deploy",
        "type": "Microsoft.Resources/deployments",
        "properties": {
          "mode": "incremental",
          "templateLink": {
            "uri": "[variables('templatelink')]",
            "contentVersion": "1.0.0.0",
            "relativePath": "./module/deploy.json"
          },
          "parameters": {
            "myKeySource": {
              "value": "[parameters('myKeySourceMain')]"
            }
          }
        }
      }
    ],
    "outputs": {}
}
